---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { sortPosts } from '../lib/posts';

const posts = sortPosts(await getCollection('blog'));
const [featured, ...rest] = posts;
---

<BaseLayout>
  <section class="hero">
    <p class="kicker">eH BLOG</p>
    <h1>Stories about building.<br />And how we get there.</h1>
    <p>Notes on engineering, systems, and everyday practice—real problems, careful thinking, and answers worth keeping.</p>
  </section>
  {featured && (
    <section class="featured">
      <a class="featured-copy" href={`/archives/${featured.data.slug}`}>
        <span class="topic">{featured.data.categories[0] || 'Latest story'}</span>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description || 'Read the latest story from the field.'}</p>
        <span class="read-more">Read the story <b>→</b></span>
      </a>
      <a class="featured-media" href={`/archives/${featured.data.slug}`} tabindex="-1">
        {featured.data.cover ? <img src={featured.data.cover} alt="" /> : <div class="cover-fallback"><span>eH</span><small>Ideas in practice.</small></div>}
      </a>
    </section>
  )}
  <section class="feed">
    <div class="section-head">
      <div><span>LATEST STORIES</span><h2>What’s new</h2></div>
      <label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search stories" aria-label="Search stories" /></label>
    </div>
    <div id="posts">
      {rest.map((post) => <PostCard post={post} />)}
      <p id="empty" class="empty" hidden>No matching stories found.</p>
    </div>
    <a class="archive-button" href="/archives/">Explore the archive <span>→</span></a>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search');
    const cards = [...document.querySelectorAll<HTMLElement>('.post-card')];
    const empty = document.querySelector<HTMLElement>('#empty');
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !query || card.dataset.search?.includes(query);
        card.hidden = !match;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
    });
  </script>
</BaseLayout>
