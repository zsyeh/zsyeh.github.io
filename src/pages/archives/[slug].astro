---
import { getCollection } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
import { sortPosts, visiblePosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(visiblePosts(await getCollection('blog')));
  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      nextPost: index > 0 ? posts[index - 1] : undefined,
      prevPost: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
---

<ArticlePage post={post} prevPost={prevPost} nextPost={nextPost} />
