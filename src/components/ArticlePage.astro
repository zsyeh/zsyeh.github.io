---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateFormatter, type Post } from '../lib/posts';

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
const isCuavSponsorship = post.data.slug === 'cuav-university-sponsorship-v6x-v2-neo4-se-gps';
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover}>
  <article class:list={["article-shell", { "cuav-sponsorship": isCuavSponsorship }]}>
    <header class="article-header">
      {isCuavSponsorship && (
        <div class="cuav-brand" aria-label="CUAV 高校赞助项目">
          <img src="/article-assets/cuav-sponsorship-2026/cuav-logo.png" alt="CUAV" />
          <span aria-hidden="true"></span>
          <div>
            <strong>高校赞助项目</strong>
            <small>项目实践记录 · 2026</small>
          </div>
        </div>
      )}
      <div class="eyebrow"><time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time><span>BY {post.data.author}</span><span>WRITTEN ON {post.data.source.toUpperCase()}</span><span>{Math.max(1, Math.ceil((post.body?.length || 0) / 900))} MIN READ</span></div>
      {isCuavSponsorship && post.data.updatedDate && <p class="cuav-updated">图文更新于 <time datetime={post.data.updatedDate.toISOString()}>{new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', dateStyle: 'long' }).format(post.data.updatedDate)}</time> · 补充安装特写、团队影像与原始报告</p>}
      <h1>{post.data.title}</h1>
      {post.data.description && <p>{post.data.description}</p>}
      <div class="chips">
        {post.data.categories.map((name: string) => <a href={`/categories/${encodeURIComponent(name)}/`}>{name}</a>)}
        {post.data.tags.map((name: string) => <a class="tag" href={`/tags/${encodeURIComponent(name)}/`}>#{name}</a>)}
      </div>
    </header>
    <div class:list={["article-grid", { "no-toc": headings.length < 3 }]}>
      <div class="prose"><Content /></div>
      {headings.length >= 3 && <aside class="toc"><strong>ON THIS PAGE</strong>{headings.filter((h) => h.depth <= 3).map((h) => <a class={`depth-${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}</aside>}
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((image) => {
    if (!image.hasAttribute('loading')) image.loading = 'lazy';
    image.decoding = 'async';

    const showFallback = () => {
      if (image.nextElementSibling?.classList.contains('image-unavailable')) return;

      const fallback = document.createElement('span');
      fallback.className = 'image-unavailable';
      fallback.textContent = image.alt
        ? `Image unavailable: ${image.alt}`
        : 'This image is temporarily unavailable.';
      image.insertAdjacentElement('afterend', fallback);
      image.hidden = true;
    };

    if (image.complete && image.naturalWidth === 0) showFallback();
    else image.addEventListener('error', showFallback, { once: true });
  });
</script>

<style>
  .cuav-updated { font-size: 13px; color: var(--muted); }
  .cuav-sponsorship :global(.prose figure) { margin: 30px 0; min-width: 0; }
  .cuav-sponsorship :global(.prose figure img) { margin: 0 auto; }
  .cuav-sponsorship :global(.prose figcaption) { margin-top: 10px; color: var(--muted); font-size: 13px; line-height: 1.65; text-align: center; }
  .cuav-sponsorship :global(.cuav-gallery) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 30px 0; align-items: start; }
  .cuav-sponsorship :global(.cuav-gallery figure) { margin: 0; }
  .cuav-sponsorship :global(.cuav-portrait) { max-width: 540px; margin-inline: auto; }
  .cuav-sponsorship :global(.cuav-attachments) { display: grid; gap: 12px; margin: 24px 0; }
  .cuav-sponsorship :global(.cuav-attachments a) { display: grid; gap: 6px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); text-decoration: none; overflow-wrap: anywhere; }
  .cuav-sponsorship :global(.cuav-attachments a:hover) { border-color: var(--blue); }
  .cuav-sponsorship :global(.cuav-attachments a:focus-visible) { outline: 2px solid var(--blue); outline-offset: 3px; }
  .cuav-sponsorship :global(.cuav-attachments span) { color: var(--muted); font-size: 13px; line-height: 1.65; }

  .cuav-brand {
    display: flex;
    width: fit-content;
    margin: 0 0 28px;
    padding: 14px 18px;
    align-items: center;
    gap: 16px;
    border: 1px solid rgba(24, 45, 76, .1);
    border-radius: 14px;
    background: linear-gradient(135deg, #fff 0%, #f5f8fb 100%);
    box-shadow: 0 10px 32px rgba(26, 44, 72, .06);
  }

  .cuav-brand img {
    width: 116px;
    height: 52px;
    margin: 0;
    border-radius: 0;
    object-fit: contain;
  }

  .cuav-brand > span {
    width: 1px;
    height: 34px;
    background: rgba(24, 45, 76, .14);
  }

  .cuav-brand div {
    display: grid;
    gap: 3px;
  }

  .cuav-brand strong {
    color: #14253d;
    font-size: 14px;
    letter-spacing: .04em;
  }

  .cuav-brand small {
    color: #6c7685;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  @media (max-width: 520px) {
    .cuav-sponsorship :global(.cuav-gallery) { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .cuav-brand {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      gap: 12px;
    }

    .cuav-brand img {
      width: 92px;
      height: 42px;
    }
  }
</style>
