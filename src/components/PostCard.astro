---
import type { Post } from '../lib/posts';
import { dateFormatter } from '../lib/posts';

const { post } = Astro.props as { post: Post };
---

<article class="post-card" data-search={`${post.data.title} ${post.data.description} ${post.data.categories.join(' ')} ${post.data.tags.join(' ')}`.toLowerCase()}>
  {post.data.cover ? <a class="post-cover" href={`/archives/${post.data.slug}`} tabindex="-1"><img src={post.data.cover} alt="" loading="lazy" /></a> : <a class="post-cover post-cover-fallback" href={`/archives/${post.data.slug}`} tabindex="-1"><span>eH</span></a>}
  <div class="post-card-content">
    <div class="eyebrow">
      <span>{post.data.categories[0] || 'Engineering Notes'}</span>
      <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
    </div>
    <h2><a href={`/archives/${post.data.slug}`}>{post.data.title}</a></h2>
    {post.data.description && <p>{post.data.description}</p>}
    <a class="card-read" href={`/archives/${post.data.slug}`}>Read article <span>→</span></a>
  </div>
</article>
