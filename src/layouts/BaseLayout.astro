---
import { SITE } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={`${SITE.title} home`}><span class="brand-e">e</span><span class="brand-h">H</span> <b>{SITE.brandSuffix}</b></a>
        <nav aria-label="Primary navigation">
          <a href="/">Home</a>
          <a href="/archives/">Archive</a>
          <a href="/categories/">Topics</a>
          <a href="/tags/">Tags</a>
        </nav>
        <a class="home-link" href="https://ehzsy.site" aria-label="Visit the eH home page">eH Home ↗</a>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <a class="footer-brand" href="/">{SITE.title}</a>
      <div><a href="/archives/">Archive</a><a href="/rss.xml">RSS</a><a href="https://ehzsy.site">Home</a></div>
      <span>© {new Date().getFullYear()} {SITE.owner} · Original author attribution retained</span>
    </footer>
  </body>
</html>
